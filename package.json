{
  "name": "wiki-auto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv .env",
    "preview": "nuxt preview",
    "build": "nuxt build",
    "prepare": "nuxt prepare",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "test:e2e": "cypress open --e2e",
    "test:e2e:ci": "cypress run",
    "test:unit": "TZ=Africa vitest",
    "test:debug": "vitest --inspect-brk",
    "test:ci": "bun run prepare && TZ=Africa vitest run",
    "test:coverage": "TZ=Africa vitest run --coverage.enabled",
    "pre-commit": "lint-staged --allow-empty",
    "generate:types": "supabase gen types typescript --project-id bgebiukwfhdwkwxtnyhy > ./shared/types/database.types.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "bunx prettier . -w"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.0.0-rc.2",
    "@pinia/nuxt": "^0.7.0",
    "@supabase/supabase-js": "2.46.2",
    "@tiptap/extension-color": "^2.10.4",
    "@tiptap/extension-placeholder": "^2.10.4",
    "@tiptap/extension-typography": "^2.10.4",
    "@tiptap/pm": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4",
    "@tiptap/vue-3": "^2.10.4",
    "@vee-validate/nuxt": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "add": "^2.0.6",
    "caniuse-lite": "^1.0.30001720",
    "dayjs": "^1.11.13",
    "http-status-codes": "^2.3.0",
    "nuxt": "^3.14.159",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^3.24.2",
    "@nuxtjs/supabase": "^1.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.2",
    "@nuxt/schema": "^3.17.5",
    "@nuxt/test-utils": "^3.14.4",
    "@pinia/testing": "^0.1.7",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^2.1.6",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cypress": "13.16.0",
    "eslint": "^9.16.0",
    "happy-dom": "^15.11.6",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "supabase": "^2.20.12",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  },
  "lint-staged": {
    "*.{json,ts,vue,mjs,cjs,json}": [
      "npx prettier --write"
    ],
    "*.{js,ts,vue,mjs,cjs,mts,json}": [
      "eslint"
    ]
  }
}
