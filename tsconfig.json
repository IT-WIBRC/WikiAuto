{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["@nuxt/schema"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "#components": ["./.nuxt/components.d.ts"] // Make `#components` available inside unit tests files
    }
  },
  "exclude": [
    "dist",
    "node_modules",
    "output",
    "test",
    "tests",
    "**/*.cy.ts",
    "**/*.worker.ts",
    "**/*.worker.ts",
    "**/cypress/**"
  ]
}
